# Imagen lista para Render / Koyeb / Fly / cualquier PaaS con Docker.
FROM php:8.2-apache

# .htaccess + reescritura de URLs
RUN a2enmod rewrite expires headers \
 && sed -ri 's!AllowOverride None!AllowOverride All!g' /etc/apache2/apache2.conf

# El PaaS inyecta el puerto en $PORT (Render usa 10000). Apache sabe leer
# variables de entorno con la sintaxis ${VAR}, asi que basta con sustituirlo.
ENV PORT=10000
RUN sed -ri 's/^Listen 80$/Listen ${PORT}/' /etc/apache2/ports.conf \
 && sed -ri 's/<VirtualHost \*:80>/<VirtualHost *:${PORT}>/' /etc/apache2/sites-enabled/000-default.conf

# No mostrar errores de PHP a los visitantes
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY . /var/www/html/
RUN chown -R www-data:www-data /var/www/html

EXPOSE 10000
CMD ["apache2-foreground"]
