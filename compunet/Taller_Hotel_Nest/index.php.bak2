$correctas = [
    // Bug 1 — ConflictException
    1  => 'ConflictException',
    2  => '409',
    3  => "throw new ConflictException('Email already in use');",

    // Bug 2 — roomId vs room
    4  => 'room: { id: createBookingDto.roomId },',
    5  => 'totalPrice',

    // Bug 3 — onDelete CASCADE
    6  => "@ManyToOne(() => Room, (room) => room.bookings, { onDelete: 'CASCADE' })",
    7  => 'ManyToOne',

    // Bug 4 — BookingModule
    8  => "import { BookingModule } from './booking/booking.module';",
    9  => 'BookingModule,',
    10 => '404',

    // Bug 5 — ValidationPipe
    11 => "import { APP_PIPE } from '@nestjs/core';",
    12 => 'provide: APP_PIPE,',
    13 => 'useValue: new ValidationPipe({ whitelist: true, forbidNonWhitelisted: true }),',

    // BookingService.cancel
    14 => "const result = await this.bookingsRepository.update(id, { status: 'cancelled' });",
    15 => 'return this.findOne(id);',

    // BookingService.hasDateConflict
    16 => "status: Not('cancelled'),",
    17 => 'checkInDate: LessThan(new Date(checkOutDate)),',
    18 => 'checkOutDate: MoreThan(new Date(checkInDate)),',
    19 => 'return (conflicts ?? []).length > 0;',

    // HotelService.searchByLocation / update / delete
    20 => 'is not a function',
    21 => 'where: { location: Like(`%${location ?? \'\'}%`) },',
    22 => 'await this.hotelsRepository.update(id, updateData);',
    23 => 'return this.findOne(id);',
    24 => 'const result = await this.hotelsRepository.delete(id);',
    25 => 'return (result.affected ?? 0) > 0;',

    // RoomService
    26 => 'where: { hotel: { id: hotelId }, available: true },',
    27 => 'return !overlaps;',
];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $formulario = ['_submitted' => true];
    $scrollPosition = isset($_POST['_scroll_y']) && is_string($_POST['_scroll_y'])
        && ctype_digit($_POST['_scroll_y'])
        ? min((int) $_POST['_scroll_y'], 2000000)
        : 0;

    if (isset($_POST['mostrar_solucion']) && is_string($_POST['mostrar_solucion'])) {
        $formulario['mostrar_solucion'] = $_POST['mostrar_solucion'];
    }

    foreach ($correctas as $i => $valor) {
        $nombre = "respuesta_$i";
        if (isset($_POST[$nombre]) && is_string($_POST[$nombre])) {
            $formulario[$nombre] = $_POST[$nombre];
        }
    }

    $_SESSION['hotel_nest_index_form'] = $formulario;
    $_SESSION['hotel_nest_index_scroll'] = $scrollPosition;
    session_write_close();
    header('Location: ./index.php#restore-scroll-' . $scrollPosition, true, 303);
    exit;
}

$formulario = $_SESSION['hotel_nest_index_form'] ?? [];
$scrollPosition = $_SESSION['hotel_nest_index_scroll'] ?? null;
unset($_SESSION['hotel_nest_index_form']);
unset($_SESSION['hotel_nest_index_scroll']);
session_write_close();

// Normaliza: los espacios NO importan en absoluto
function normalizar($str) {
    return preg_replace('/\s+/', '', $str);
}

for ($i = 1; $i <= 60; $i++) {
    ${"respuesta_" . $i} = '';
    ${"verificar_" . $i} = '';
}

$mostrar_solucion = '';
if (!empty($formulario['_submitted'])) {
    $mostrar_solucion = isset($formulario['mostrar_solucion']) ? trim($formulario['mostrar_solucion']) : '';
    $clave = strtolower(str_replace([' ', '_', '-', 'ó', 'Ó'], ['', '', '', 'o', 'o'], $mostrar_solucion));

    if ($clave === 'mostrarsolucion') {
        foreach ($correctas as $i => $valor) {
            ${"respuesta_" . $i} = $valor;
            ${"verificar_" . $i} = "correcto";
        }
    } else {
        foreach ($correctas as $i => $valor) {
            $enviado = isset($formulario["respuesta_$i"]) ? $formulario["respuesta_$i"] : '';
            ${"respuesta_" . $i} = $enviado;
            $e = normalizar($enviado);
            if ($e === normalizar($valor))      ${"verificar_" . $i} = "correcto";
            elseif ($e === '')                   ${"verificar_" . $i} = '';
            else                                 ${"verificar_" . $i} = "incorrecto";
        }
    }
}

// Pinta un input con el valor enviado y el borde según el resultado
function campo($i, $size) {
    $val = $GLOBALS["respuesta_$i"];
    $ver = $GLOBALS["verificar_$i"];
    $cls = $ver === 'correcto' ? 'ok' : ($ver === 'incorrecto' ? 'mal' : '');
    return '<input type="text" class="' . $cls . '" name="respuesta_' . $i . '" value="'
         . htmlspecialchars($val, ENT_QUOTES) . '" size="' . $size . '" spellcheck="false">';
}

// Resultado de un bloque de preguntas
function verificar(...$ids) {
    $out = '';
    foreach ($ids as $i) {
        $v = $GLOBALS["verificar_$i"];
        if ($v === '') continue;
        $out .= '<span class="v ' . ($v === 'correcto' ? 'ok' : 'mal') . '">' . $i . ': ' . $v . '</span> ';
    }
    return $out;
}
?>
